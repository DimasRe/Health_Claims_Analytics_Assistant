# --- Database (wajib) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claims_demo
DB_USER=analytics_readonly
DB_PASSWORD=your_password_here

# --- Database (opsional) ---
DB_STATEMENT_TIMEOUT=30s
DB_WORK_MEM=256MB
QUERY_CACHE_TTL=600
DISTINCT_COUNT_REWRITE=1

# --- Model (Ollama) ---
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT=180
OLLAMA_THINK=0
MAX_HISTORY_TURNS=6
TOOL_SELECTION=1

# --- API & UI ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=
ANSWER_CHARTS=1
CHART_MAX_CATEGORIES=20
LOG_LEVEL=INFO
